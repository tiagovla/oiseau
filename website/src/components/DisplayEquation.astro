import { renderToString } from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  class?: string;
}

const { tex, class: className } = Astro.props;
---

<div
  class:list={[
    'overflow-x-auto rounded-md border border-gray-700/50 bg-oiseau-deep-blue px-4 text-base sm:text-xl',
    className,
  ]}
  set:html={renderToString(tex, { displayMode: true })}
/>
